#!/usr/bin/env bash
# devenvify - set a folder up with one of the shared devenv templates.
#
#   devenvify                                   list templates and modes
#   devenvify --shared   <template> [dir] [-f]  import the shared parts
#   devenvify --copy     <template> [dir] [-f]  copy them into the repo
#   devenvify --personal <template> [dir]       bind on this machine only
#
# The mode decides who owns the setup, and there is no default: devenvify
# stops and explains when none is given.
#
# A template is a preset of parts. Its devenv.yaml lists the parts it uses
# from devenv-templates/modules under `imports:`, next to a near-empty
# devenv.nix for the project's own additions, .envrc and .vscode/. Templates
# live in $DEVENV_TEMPLATES_DIR (default ~/code/repos/devenv-templates), one
# subfolder with a devenv.yaml each. Every file is copied as-is, except:
#   - `gitignore` is not copied; its lines are appended to the target's .gitignore
#     when missing.
#   - `@NAME@` is replaced with the target folder's name (lowercased, [a-z0-9-]).
#   - a devenv.yaml it writes gets devenv's own modules pinned to the version
#     of the devenv on this machine (see pin_devenv).
#   - with --copy, devenv.yaml imports the parts from devenv-shared/ in the
#     repo instead, and the parts are copied there.
# Existing files are left alone unless -f is given.
set -euo pipefail

templates_dir="${DEVENV_TEMPLATES_DIR:-$HOME/code/repos/devenv-templates}"

# Where projects fetch devenv-templates from: the devenv.yaml imports, and
# --personal. Override to try changes before they are pushed, e.g.
#   DEVENV_TEMPLATES_REPO=path:$HOME/code/repos/devenv-templates devenvify --shared dotnet
templates_repo="${DEVENV_TEMPLATES_REPO:-github:JesperJ/devenv-templates}"

explain_modes() {
  cat <<'EOF'
Pick who owns the setup:

  --shared    devenv.yaml imports the shared parts from devenv-templates.
              devenv.lock pins the commit; `update-shared` takes a newer one.
              One setup for every project, improved in one place.

  --copy      the parts are copied into the repo, in devenv-shared/, and are
              the repo's own from then on: no devenv-templates input, nothing
              pulled. Edit them freely; nobody else's change reaches them.

  --personal  nothing goes into the repo's history: this machine binds the
              folder to the template (devenv --from). For a repo you can't
              commit devenv files to. Follows devenv-templates' main.

In every mode devenv.lock pins nixpkgs, and so the SDK; `update-toolchain`
moves it. With --shared and --copy that lock is committed; with --personal
it stays on this machine.

  e.g.  devenvify --shared dotnet
EOF
}

# Pin devenv's modules to the devenv installed here. A devenv.yaml with no
# devenv input gets the newest devenv on GitHub locked in at the first build
# -- not the version of the devenv command doing the build -- and a command
# older than its modules prints errors into every shell it loads. Pinned to
# the installed version, the modules can never be newer than the command, and
# a later, newer devenv still loads them fine.
#
# Added here rather than written into the templates, so a template stays a
# valid devenv.yaml for `nix flake init -t`, which copies files verbatim.
pin_devenv() {
  local yaml=$1 version
  grep -qE '^[[:space:]]+devenv:' "$yaml" && return 0
  version=$(devenv version 2>/dev/null | sed -nE 's/^devenv ([0-9]+\.[0-9]+\.[0-9]+).*/v\1/p' || true)
  if [ -z "$version" ]; then
    echo "note   no devenv on PATH; devenv.yaml left without a devenv pin" >&2
    return 0
  fi
  local block="  devenv:\n    url: github:cachix/devenv/$version"
  if grep -qE '^inputs:[[:space:]]*$' "$yaml"; then
    sed -i -E "0,/^inputs:[[:space:]]*$/s||inputs:\n$block|" "$yaml"
  else
    printf 'inputs:\n%b\n' "$block" >> "$yaml"
  fi
  echo "pinned devenv $version in devenv.yaml"
}

# A template is a folder with a devenv.yaml; modules/ and from/ are not.
list_templates() {
  echo "Templates in $templates_dir:"
  for t in "$templates_dir"/*/; do
    if [ -f "$t/devenv.yaml" ]; then echo "  $(basename "$t")"; fi
  done
}

# The parts a template uses: the devenv-templates/modules/<part> lines under
# `imports:` in its devenv.yaml.
template_parts() {
  sed -nE 's|^[[:space:]]*-[[:space:]]*devenv-templates/modules/([^[:space:]]+)[[:space:]]*$|\1|p' "$1/devenv.yaml"
}

# Write one file into the target, honouring -f: <rel> <template file>, with
# the content read from the template file, or from [input] (/dev/stdin when
# the content is piped in). Returns 1 if the file was skipped.
write_file() {
  local rel=$1 src=$2 input=${3:-$2} dest="$target/$1"
  if [ -e "$dest" ] && [ "$force" -eq 0 ]; then
    echo "skip   $rel (exists, -f to overwrite)"
    [ "$input" = /dev/stdin ] && cat > /dev/null
    return 1
  fi
  mkdir -p "$(dirname "$dest")"
  sed -e "s/@NAME@/$name/g" -e "s|github:JesperJ/devenv-templates|$templates_repo|g" "$input" > "$dest"
  # Keep the executable bit, but not the Nix store's read-only mode.
  chmod --reference="$src" "$dest"
  chmod u+w "$dest"
  echo "wrote  $rel"
}

# --copy: the template's devenv.yaml without the devenv-templates input, its
# imports pointing at the copies in devenv-shared/.
copy_yaml() {
  sed -E \
    -e '/^  # The shared setup/,/^    flake: false/d' \
    -e 's|^# The parts this project uses\.|# The parts this project uses, copied into devenv-shared/ by devenvify --copy\n# and owned by this repo.|' \
    -e 's|devenv-templates/modules/|./devenv-shared/|' \
    "$1"
}

# --copy: the parts themselves, each with a note on where it came from.
copy_parts() {
  local part from rev
  # A checkout knows its commit; the packaged devenvify is told it.
  rev=$(git -C "$templates_dir" rev-parse --short HEAD 2>/dev/null || echo "${DEVENV_TEMPLATES_REV:-}")
  from="devenv-templates${rev:+ $rev}"
  for part in "${parts[@]}"; do
    local dir="$templates_dir/modules/$part"
    if [ ! -f "$dir/devenv.nix" ]; then
      echo "Template '$template' imports a part that does not exist: modules/$part" >&2
      exit 1
    fi
    while IFS= read -r -d '' file; do
      local rel="devenv-shared/$part/${file#"$dir"/}"
      if [ "${file##*.}" = nix ]; then
        { printf '# Copied from %s modules/%s by devenvify --copy, %s.\n' "$from" "$part" "$(date +%F)"
          printf "# This repo's own copy now: edit it freely; update-shared does not touch it.\n#\n"
          cat "$file"; } | write_file "$rel" "$file" /dev/stdin || true
      else
        write_file "$rel" "$file" || true
      fi
    done < <(find "$dir" -type f -print0)
  done
}

# --personal: use a template in a repo that must not get devenv files: a
# customer's, an open-source project. devenv binds the folder to
# from/<template> on this machine only; colleagues who want the same run the
# same command.
bind() {
  local src
  if [ ! -f "$templates_dir/from/$template/devenv.nix" ]; then
    echo "No template '$template' to bind." >&2
    list_templates >&2
    exit 1
  fi
  if ! command -v devenv >/dev/null 2>&1; then
    echo "devenv is not on PATH." >&2
    exit 1
  fi
  # A devenv.nix in the folder silently replaces a binding -- the shell would
  # be the folder's, not the template's.
  if [ -e "$target/devenv.nix" ]; then
    echo "$target has its own devenv.nix, which would replace the binding." >&2
    echo "Use --shared or --copy here, or remove devenv.nix first." >&2
    exit 1
  fi
  case "$templates_repo" in
    path:*) src="$templates_repo/from/$template" ;;   # a local source takes a plain path
    *) src="$templates_repo?dir=from/$template" ;;
  esac
  mkdir -p "$target"
  cd "$target"
  devenv --from "$src" allow

  # devenv still keeps its state in the folder (.devenv/, devenv.lock), and
  # direnv needs an .envrc to load the shell on cd -- which is also how VS
  # Code's direnv extension hands the C# Dev Kit its environment. All of it is
  # hidden from git in .git/info/exclude, which belongs to this clone only, so
  # the repo's own .gitignore stays untouched.
  if [ ! -e .envrc ]; then
    # Quoted heredoc: written literally, for direnv to expand later.
    cat > .envrc <<'EOF'
#!/usr/bin/env bash

eval "$(devenv direnvrc)"
use devenv
EOF
    echo "wrote  .envrc (not committed)"
  fi
  if [ -d .git ]; then
    mkdir -p .git/info
    touch .git/info/exclude
    for l in '.devenv*' 'devenv.lock' '.direnv' '.envrc'; do
      grep -qxF "$l" .git/info/exclude || echo "$l" >> .git/info/exclude
    done
    echo "hid    devenv's files from git in .git/info/exclude"
  fi
  if command -v direnv >/dev/null 2>&1; then
    direnv allow .
    echo "direnv allowed - cd in (or 'direnv reload') to build the shell"
  fi
}

force=0
mode=
args=()
for a in "$@"; do
  case "$a" in
    -f | --force) force=1 ;;
    --shared | --copy | --personal)
      if [ -n "$mode" ] && [ "$mode" != "${a#--}" ]; then
        echo "Pick one of --shared, --copy and --personal." >&2
        exit 1
      fi
      mode=${a#--}
      ;;
    --bind)
      echo "--bind is now --personal." >&2
      exit 1
      ;;
    -h | --help)
      echo "usage: devenvify --shared   <template> [dir] [-f]   import the shared parts"
      echo "       devenvify --copy     <template> [dir] [-f]   copy them into the repo"
      echo "       devenvify --personal <template> [dir]        bind on this machine only"
      echo "       devenvify                                    list templates and modes"
      echo
      explain_modes
      exit 0
      ;;
    -*)
      echo "Unknown option: $a (devenvify -h)" >&2
      exit 1
      ;;
    *) args+=("$a") ;;
  esac
done

if [ "${#args[@]}" -eq 0 ]; then
  list_templates
  echo
  explain_modes
  exit 0
fi

template="${args[0]}"
target="$(realpath "${args[1]:-.}")"
src="$templates_dir/$template"

if [ ! -f "$src/devenv.yaml" ]; then
  echo "No template '$template'." >&2
  list_templates >&2
  exit 1
fi
if [ -z "$mode" ]; then
  echo "devenvify $template: which mode?" >&2
  echo >&2
  explain_modes >&2
  exit 1
fi

if [ "$mode" = personal ]; then
  bind
  exit 0
fi

mkdir -p "$target"
name="$(basename "$target" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9-]/-/g')"
mapfile -t parts < <(template_parts "$src")

while IFS= read -r -d '' file; do
  rel="${file#"$src"/}"
  [ "$rel" = gitignore ] && continue
  if [ "$rel" = devenv.yaml ] && [ "$mode" = copy ]; then
    copy_yaml "$file" | write_file "$rel" "$file" /dev/stdin || continue
  else
    write_file "$rel" "$file" || continue
  fi
  if [ "$rel" = devenv.yaml ]; then pin_devenv "$target/$rel"; fi
done < <(find "$src" -type f -print0)

if [ "$mode" = copy ]; then copy_parts; fi

if [ -f "$src/gitignore" ]; then
  touch "$target/.gitignore"
  added=0
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    # Whole-line match; the \r variant counts a CRLF .gitignore's line as present.
    if ! grep -qxF -e "$line" -e "$line"$'\r' "$target/.gitignore"; then
      if [ "$added" -eq 0 ]; then
        # Start on a fresh line, with a header.
        [ -s "$target/.gitignore" ] && [ -n "$(tail -c1 "$target/.gitignore")" ] && echo >> "$target/.gitignore"
        printf '\n# devenv\n' >> "$target/.gitignore"
      fi
      echo "$line" >> "$target/.gitignore"
      added=$((added + 1))
    fi
  done < "$src/gitignore"
  [ "$added" -gt 0 ] && echo "added  $added line(s) to .gitignore"
fi

if command -v direnv >/dev/null 2>&1 && [ -f "$target/.envrc" ]; then
  direnv allow "$target"
  echo "direnv allowed - cd in (or 'direnv reload') to build the shell"
fi
