#!/usr/bin/env bash
# devenvify - set a folder up with one of the shared devenv templates.
#
#   devenvify                          list templates
#   devenvify <template> [dir] [-f]    write the template into a project
#   devenvify --bind <template> [dir]  use it in a repo you can't commit to
#
# A template is thin: a devenv.yaml that IMPORTS the shared setup from
# devenv-templates/modules (pinned in the project's devenv.lock, moved with
# `update-shared`), a near-empty devenv.nix for the project's own additions,
# .envrc and .vscode/. Templates live in $DEVENV_TEMPLATES_DIR (default
# ~/code/repos/devenv-templates), one subfolder with a devenv.yaml each. Every
# file is copied as-is, except:
#   - `gitignore` is not copied; its lines are appended to the target's .gitignore
#     when missing.
#   - `@NAME@` is replaced with the target folder's name (lowercased, [a-z0-9-]).
#   - a devenv.yaml it writes gets devenv's own modules pinned to the version
#     of the devenv on this machine (see pin_devenv).
# Existing files are left alone unless -f is given.
#
# --bind writes nothing into the repo: devenv remembers, on this machine only,
# that the folder uses from/<template> (`devenv --from ... allow`).
set -euo pipefail

templates_dir="${DEVENV_TEMPLATES_DIR:-$HOME/code/repos/devenv-templates}"

# Where projects fetch devenv-templates from: the devenv.yaml imports, and
# --bind. Override to try changes before they are pushed, e.g.
#   DEVENV_TEMPLATES_REPO=path:$HOME/code/repos/devenv-templates devenvify dotnet
templates_repo="${DEVENV_TEMPLATES_REPO:-github:JesperJ/devenv-templates}"

# Pin devenv's modules to the devenv installed here. A devenv.yaml with no
# devenv input gets the newest devenv on GitHub locked in at the first build
# -- not the version of the devenv command doing the build -- and a command
# older than its modules prints errors into every shell it loads. Pinned to
# the installed version, the modules can never be newer than the command, and
# a later, newer devenv still loads them fine.
#
# Added here rather than written into the templates, so a template stays a
# valid devenv.yaml for `nix flake init -t`, which copies files verbatim.
pin_devenv() {
  local yaml=$1 version
  grep -qE '^[[:space:]]+devenv:' "$yaml" && return 0
  version=$(devenv version 2>/dev/null | sed -nE 's/^devenv ([0-9]+\.[0-9]+\.[0-9]+).*/v\1/p' || true)
  if [ -z "$version" ]; then
    echo "note   no devenv on PATH; devenv.yaml left without a devenv pin" >&2
    return 0
  fi
  local block="  devenv:\n    url: github:cachix/devenv/$version"
  if grep -qE '^inputs:[[:space:]]*$' "$yaml"; then
    sed -i -E "0,/^inputs:[[:space:]]*$/s||inputs:\n$block|" "$yaml"
  else
    printf 'inputs:\n%b\n' "$block" >> "$yaml"
  fi
  echo "pinned devenv $version in devenv.yaml"
}

# A template is a folder with a devenv.yaml; modules/ and from/ are not.
list_templates() {
  echo "Templates in $templates_dir:"
  for t in "$templates_dir"/*/; do
    if [ -f "$t/devenv.yaml" ]; then echo "  $(basename "$t")"; fi
  done
}

# Use a template in a repo that must not get devenv files: a customer's, an
# open-source project. devenv binds the folder to from/<template> on this
# machine only; colleagues who want the same run the same command.
bind() {
  local template=$1 target=$2 src
  if [ ! -f "$templates_dir/from/$template/devenv.nix" ]; then
    echo "No template '$template' to bind." >&2
    list_templates >&2
    exit 1
  fi
  if ! command -v devenv >/dev/null 2>&1; then
    echo "devenv is not on PATH." >&2
    exit 1
  fi
  case "$templates_repo" in
    path:*) src="$templates_repo/from/$template" ;;   # a local source takes a plain path
    *) src="$templates_repo?dir=from/$template" ;;
  esac
  mkdir -p "$target"
  cd "$target"
  devenv --from "$src" allow

  # devenv still keeps its state in the folder (.devenv/, devenv.lock), and
  # direnv needs an .envrc to load the shell on cd -- which is also how VS
  # Code's direnv extension hands the C# Dev Kit its environment. All of it is
  # hidden from git in .git/info/exclude, which belongs to this clone only, so
  # the repo's own .gitignore stays untouched.
  if [ ! -e .envrc ]; then
    # Quoted heredoc: written literally, for direnv to expand later.
    cat > .envrc <<'EOF'
#!/usr/bin/env bash

eval "$(devenv direnvrc)"
use devenv
EOF
    echo "wrote  .envrc (not committed)"
  fi
  if [ -d .git ]; then
    mkdir -p .git/info
    touch .git/info/exclude
    for l in '.devenv*' 'devenv.lock' '.direnv' '.envrc'; do
      grep -qxF "$l" .git/info/exclude || echo "$l" >> .git/info/exclude
    done
    echo "hid    devenv's files from git in .git/info/exclude"
  fi
  if command -v direnv >/dev/null 2>&1; then
    direnv allow .
    echo "direnv allowed - cd in (or 'direnv reload') to build the shell"
  fi
}

force=0
bind_mode=0
args=()
for a in "$@"; do
  case "$a" in
    -f | --force) force=1 ;;
    --bind) bind_mode=1 ;;
    -h | --help)
      echo "usage: devenvify [<template> [dir] [-f]]     write a template into a project"
      echo "       devenvify --bind <template> [dir]     use it without writing files"
      echo "       devenvify                             list templates"
      exit 0
      ;;
    *) args+=("$a") ;;
  esac
done

if [ "${#args[@]}" -eq 0 ]; then
  list_templates
  exit 0
fi

template="${args[0]}"
target="$(realpath "${args[1]:-.}")"
src="$templates_dir/$template"

if [ "$bind_mode" -eq 1 ]; then
  bind "$template" "$target"
  exit 0
fi

if [ ! -f "$src/devenv.yaml" ]; then
  echo "No template '$template'." >&2
  list_templates >&2
  exit 1
fi
mkdir -p "$target"

name="$(basename "$target" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9-]/-/g')"

while IFS= read -r -d '' file; do
  rel="${file#"$src"/}"
  [ "$rel" = gitignore ] && continue
  dest="$target/$rel"
  if [ -e "$dest" ] && [ "$force" -eq 0 ]; then
    echo "skip   $rel (exists, -f to overwrite)"
    continue
  fi
  mkdir -p "$(dirname "$dest")"
  sed -e "s/@NAME@/$name/g" -e "s|github:JesperJ/devenv-templates|$templates_repo|g" "$file" > "$dest"
  # Keep the executable bit, but not the Nix store's read-only mode.
  chmod --reference="$file" "$dest"
  chmod u+w "$dest"
  echo "wrote  $rel"
  if [ "$rel" = devenv.yaml ]; then pin_devenv "$dest"; fi
done < <(find "$src" -type f -print0)

if [ -f "$src/gitignore" ]; then
  touch "$target/.gitignore"
  added=0
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    # Whole-line match; the \r variant counts a CRLF .gitignore's line as present.
    if ! grep -qxF -e "$line" -e "$line"$'\r' "$target/.gitignore"; then
      if [ "$added" -eq 0 ]; then
        # Start on a fresh line, with a header.
        [ -s "$target/.gitignore" ] && [ -n "$(tail -c1 "$target/.gitignore")" ] && echo >> "$target/.gitignore"
        printf '\n# devenv\n' >> "$target/.gitignore"
      fi
      echo "$line" >> "$target/.gitignore"
      added=$((added + 1))
    fi
  done < "$src/gitignore"
  [ "$added" -gt 0 ] && echo "added  $added line(s) to .gitignore"
fi

if command -v direnv >/dev/null 2>&1 && [ -f "$target/.envrc" ]; then
  direnv allow "$target"
  echo "direnv allowed - cd in (or 'direnv reload') to build the shell"
fi
